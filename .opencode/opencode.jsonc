{
  "$schema": "https://opencode.ai/config.json",
  // Project-specific permissions for this repo.
  // Rules are ordered; the LAST matching rule wins. These are appended after
  // global rules and the base policy, so the `ask` rules below override the
  // default allow for guard files, and the `allow` rules pre-approve this
  // repo's blessed command surface.
  "permissions": [
    // ---- Project tooling (justfile owns the workflows) ----
    { "action": "shell", "resource": "just *", "effect": "allow" },
    // ---- uv operations for the two project environments ----
    { "action": "shell", "resource": "uv lock *", "effect": "allow" },
    { "action": "shell", "resource": "uv sync *", "effect": "allow" },
    { "action": "shell", "resource": "uv run pytest*", "effect": "allow" },
    { "action": "shell", "resource": "uv run pip-audit*", "effect": "allow" },
    { "action": "shell", "resource": "uv run ruff*", "effect": "allow" },
    { "action": "shell", "resource": "uv run basedpyright*", "effect": "allow" },
    { "action": "shell", "resource": "uv run python*", "effect": "allow" },
    { "action": "shell", "resource": "uv pip list*", "effect": "allow" },
    // ---- Gate binary (runs from skills/scripts) ----
    { "action": "shell", "resource": "jscpd *", "effect": "allow" },
    // ---- Read-only git ----
    { "action": "shell", "resource": "git status*", "effect": "allow" },
    { "action": "shell", "resource": "git diff*", "effect": "allow" },
    { "action": "shell", "resource": "git log*", "effect": "allow" },
    { "action": "shell", "resource": "git show*", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git check-ignore *", "effect": "allow" },
    // Staging is safe to pre-approve: commits of openspec/ paths are blocked
    // separately by the openspec-commit-guard plugin (.opencode/plugins/).
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    // ---- Guard files: agent edits require explicit approval ----
    // Universal hook scripts (incl. block-openspec-commit.sh)
    { "action": "edit", "resource": ".agents/hooks/*", "effect": "ask" },
    // OpenCode plugins and this config file itself
    { "action": "edit", "resource": ".opencode/*", "effect": "ask" },
    // Claude-side guard files (local-only, tamper-sensitive)
    { "action": "edit", "resource": ".claude/*", "effect": "ask" }
  ]
}
